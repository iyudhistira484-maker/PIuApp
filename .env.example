# Frontend: public Supabase credentials only. Never put service-role keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Backend only: compatible chat/completions endpoint.
LLM_BASE_URL=
LLM_API_KEY=
# Optional default model. Blank = first model returned by GET LLM_BASE_URL/models.
# The AI chat picker lists every model this API key serves and sends the chosen id.
LLM_MODEL=
# Optional per-tier model overrides. Mapping a model to a tier also sets what
# that model costs: Cepat 1, Seimbang 3, Kuat 8 credits per chat turn (Ask 1,
# Plan 2). Models without an override bill as Seimbang, and the picker prints
# the price the server will charge.
LLM_MODEL_CEPAT=
LLM_MODEL_SEIMBANG=
LLM_MODEL_KUAT=
# Research mode. Web search needs the provider NAME and its key: tavily, exa,
# brave or parallel (none = web search stays off and fails closed).
# Recommended: tavily — free for personal use up to 1,000 credits per month and
# one credit per basic search. Set SEARCH_PROVIDER=tavily after pasting the key;
# without the key the app still fails closed (503) instead of faking results.
SEARCH_PROVIDER=none
SEARCH_API_KEY=
# Every search path needs a key: the keyless code/docs paths (grep.app, Context7)
# were removed, so without SEARCH_API_KEY nothing is called and web search stays
# closed (503) instead of returning anonymous results.
# Verify with a real call once a key is set: npm run verify:search (--all, --provider=tavily, --read, --json)
# Search rounds per request, 1-3 (default 2); each round costs 1 credit and is
# refunded when it adds no source.
# SEARCH_ROUNDS_MAX=2
# Set SEARCH_ENABLED=false to switch every outbound search off server-wide.
# SEARCH_ENABLED=true
# Shared search cache in the migration 009 table; false = per-process only.
# SEARCH_CACHE_SHARED=true
# Finished research answers are mirrored to the shared table (migration 009) so
# they survive a restart; RESEARCH_JOBS_SHARED=false keeps them in process only.
# RESEARCH_JOBS_SHARED=true
# How long a finished answer waits to be collected (default 360 minutes, max 7 days).
# RESEARCH_JOB_TTL_MINUTES=360
# The abstractive cross-page synthesis is one extra model pass per turn, billed
# inside the research round's credit. RESEARCH_SUMMARY=false keeps turns on the
# deterministic excerpts only.
# RESEARCH_SUMMARY=true
# Read-only server tools (list_files, read_file, dry_run_ops) run in every mode:
# no network, no credits. TOOL_ROUNDS_MAX caps their rounds per request; dry_run_ops
# appears only for a Roblox project in Builder mode.
# TOOL_ROUNDS_MAX=2
# Backend only — NEVER prefix these with VITE_. See docs/SERVICES_SETUP.md.
SUPABASE_SERVICE_ROLE_KEY=
APP_BASE_URL=
# AES-256-GCM master key: 64 hex characters. Store in a secret manager.
SECRETS_ENCRYPTION_KEY=
# Supabase Send SMS Hook (Standard Webhooks) + Meta Authentication template
SUPABASE_SMS_HOOK_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_LANGUAGE=id
WHATSAPP_GRAPH_VERSION=v22.0
# Isolated Node sandbox. Template must include Node, npm, Chromium, Lighthouse CLI.
E2B_API_KEY=
E2B_TEMPLATE=
# Select one provider. Keep PAYMENT_LIVE=false until provider sandbox tests pass.
PAYMENT_PROVIDER=midtrans
PAYMENT_LIVE=false
MIDTRANS_SERVER_KEY=
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
# Optional invite email delivery
RESEND_API_KEY=
EMAIL_FROM=
# Random server secret used only for rotating analytics hashes, not raw IP storage
ANALYTICS_HASH_KEY=
# Comma-separated trusted proxy CIDRs; leave blank if directly exposed.
# Do not set to arbitrary trust-all values. Rate limiting depends on this.
TRUST_PROXY_CIDRS=

# Optional public URL for a self-hosted hero MP4. Blank uses the selected Pixabay video.
VITE_HERO_VIDEO_URL=

# Production requires PostgreSQL shared admission controls (migration 007).
# Development defaults to memory; production defaults to database and rejects memory.
# RATE_LIMIT_MODE=database
# Interactive sandbox requests require sticky routing by authenticated account.
# Every replica must point to the same database; process owners are generated automatically.
