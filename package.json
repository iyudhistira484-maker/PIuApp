{
  "name": "piwuapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/dev.mjs\" \"vite --host 0.0.0.0\"",
    "prebuild": "npm run plugin:rbxmx",
    "build": "tsc -b && vite build",
    "plugin:rbxmx": "node scripts/build-plugin-rbxmx.mjs",
    "plugin:check": "node scripts/build-plugin-rbxmx.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --import ./tests/storage-setup.mjs --test --test-concurrency=2 tests/*.test.ts",
    "test:e2e": "playwright test",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.mjs",
    "test:e2e:sandbox": "node scripts/test-browser-sandbox.mjs",
    "verify:readiness": "node scripts/verify-readiness.mjs",
    "verify:search": "node --env-file-if-exists=.env scripts/verify-search-providers.mjs",
    "test:security": "node --import tsx --import ./tests/storage-setup.mjs --test --test-concurrency=2 tests/production-hardening.test.ts tests/admin.test.ts tests/services.test.ts tests/services-db.test.ts tests/studio-api.test.ts",
    "verify:production": "node scripts/verify-production.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "sql:bundle": "node scripts/build-sql-install.mjs",
    "sql:check": "node scripts/build-sql-install.mjs --check"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "@tailwindcss/vite": "^4.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "e2b": "^2.56.0",
    "express": "^5.1.0",
    "idb": "^8.0.4",
    "ipaddr.js": "^2.5.0",
    "jszip": "^3.10.1",
    "lighthouse": "^13.5.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "standardwebhooks": "^1.1.1",
    "sucrase": "^3.35.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.0",
    "three": "^0.186.1",
    "undici": "^8.11.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@playwright/test": "^1.64.0",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "esbuild": "^0.25.0",
    "luau-web": "^1.5.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
